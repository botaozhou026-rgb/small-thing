{
  "name": "zread",
  "productName": "ZRead",
  "version": "0.1.0",
  "private": true,
  "description": "轻量本地 TXT 阅读器",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/setup-electron.mjs",
    "icons": "node scripts/icons.mjs",
    "desktop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node scripts/test.mjs",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run build && npm test && playwright test",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.1",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "electron": "^45.3.1",
    "esbuild": "^0.27.0",
    "iconv-lite": "^0.7.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
